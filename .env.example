# ==========================================================================
#  KONFIGURASI WhatsApp Bot Pencatat Keuangan
#  Salin file ini menjadi `.env` lalu isi nilainya:  cp .env.example .env
# ==========================================================================

# ---------------- Google Gemini (AI Parsing) ----------------
# API Key dari https://aistudio.google.com/apikey
#
# ROTASI API KEY: boleh simpan 3 atau lebih API key (pisah dengan koma).
# Setiap API key = 1 project Google = kuota TERPISAH, jadi begitu satu key
# kena limit (429 / RESOURCE_EXHAUSTED) atau tidak valid (401/403), bot
# otomatis pindah ke key berikutnya (lalu ke model berikutnya).
#   Contoh: GEMINI_API_KEYS=key1,key2,key3
#   API key yang sama di dua tempat tidak dihitung dua kali (otomatis dedup).
GEMINI_API_KEYS=isi_api_key_anda
# Key tunggal (tunggal) — tetap didukung & digabung dengan daftar di atas.
GEMINI_API_KEY=isi_api_key_anda
# Model yang dipakai untuk parsing teks/voice note.
#   BISA DAFTAR BEBERAPA MODEL (pisah koma) -> bot otomatis pakai model
#   berikutnya begitu satu model kena error 429 (kuota free tier habis).
#   Urutan = prioritas, model pertama yang berhasil langsung dipakai.
#
#   CATATAN: model lama seperti gemini-2.5-flash sudah TIDAK tersedia untuk
#   pengguna baru (error 404). Kuota free tier dibatasi ~20 request per
#   model per periode, jadi siapkan beberapa model sebagai cadangan:
#     gemini-3.6-flash      -> flash terbaru, kuota terpisah
#     gemini-3.8-flash      -> flash paling baru
#     gemini-3.5-flash-lite -> ringan (TIDAK mendukung thinkingConfig)
#     gemini-3-flash-preview-> preview, kadang 503 saat ramai
#     gemini-3.1-flash-lite -> paling ringan, cadangan terakhir
#   Bila muncul error "model not found" atau 429, jalankan perintah berikut
#   untuk melihat daftar model yang masih tersedia:
#     curl -H "x-goog-api-key: $GEMINI_API_KEY" \
#       https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=gemini-3.6-flash,gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3-flash-preview,gemini-3.1-flash-lite

# ---------------- Owner / Admin Bot ----------------
# Nomor WhatsApp owner (pemilik bot). Bot mengirim LAPORAN ke nomor ini
# saat semua kuota Gemini habis (429) atau semua API key tidak valid.
# Boleh format lokal (0852...) atau internasional (62852...).
OWNER_NUMBER=isi_nomor_owner_anda
# Jeda minimal antar laporan ke owner (menanti spam), dalam menit
OWNER_ALERT_COOLDOWN_MIN=15

# ---------------- WhatsApp / Baileys ----------------
# Ada DUA metode koneksi: PAIRING CODE dan QR CODE.
# Saat dijalankan di terminal (TTY), bot MENANYAKAN pilihan metode lebih dulu.
#
# CONNECTION_METHOD hanya dipakai sebagai DEFAULT/saran, dan WAJIB diisi bila
# bot dijalankan tanpa terminal (docker/systemd/cron) supaya tidak menggantung.
#   pairing -> tautkan dengan nomor telepon (butuh BOT_NUMBER)
#   qr      -> tautkan dengan memindai QR (BOT_NUMBER opsional)
CONNECTION_METHOD=pairing

# Nomor BOT dalam format internasional: tanpa '+', tanpa spasi, tanpa strip.
# Contoh: 6281234567890
#
# Dipakai untuk metode PAIRING. Bila dikosongkan, bot akan MENANYAKAN nomor
# ini di terminal saat dijalankan (hanya bila stdin adalah TTY). Format lokal
# seperti 081234567890 juga diterima dan otomatis dinormalisasi ke 62xxx.
#
# Untuk metode QR, nomor ini tidak wajib (identitas didapat dari hasil pindai).
BOT_NUMBER=6281234567890

# Folder penyimpanan sesi WhatsApp (jangan di-commit ke git)
SESSION_DIR=./baileys_auth

# ---------------- Database Lokal (File JSON) ----------------
# Folder berisi users.json, transactions.json, wallets.json, budgets.json
DATA_DIR=./data

# ---------------- Backup Excel ----------------
BACKUP_DIR=./backups
# File backup lama dibersihkan otomatis setelah N hari
BACKUP_MAX_AGE_DAYS=7
# 'true' = file .xlsx tidak dihapus setelah terkirim (untuk debugging)
KEEP_BACKUP_FILE=false

# ---------------- Cronjob (format cron 5 kolom) ----------------
# Zona waktu semua jadwal
TIMEZONE=Asia/Jakarta
# Backup otomatis: setiap Minggu pukul 20:00
CRON_BACKUP_WEEKLY=0 20 * * 0
# Laporan + backup bulanan: tanggal 1 pukul 08:00 (periode bulan sebelumnya)
CRON_REPORT_MONTHLY=0 8 1 * *
# Pembersihan file backup lama: setiap hari pukul 03:00
CRON_PRUNE_BACKUPS=0 3 * * *

# ---------------- Lainnya ----------------
# Prefix perintah chat (default '!')
COMMAND_PREFIX=!
# Level log internal Baileys: silent | error | warn | info | debug
#   Ubah ke 'warn' atau 'info' bila sedang menelusuri masalah koneksi.
BAILEYS_LOG_LEVEL=silent

# ---------------- Identitas WhatsApp Web ----------------
# Versi WhatsApp Web yang diiklankan ke server, format: major,minor,patch.
#   Nilai ini DI-PIN (mengikuti neoxr-bot). Biarkan seperti ini bila koneksi
#   normal. Bila WhatsApp memutus koneksi terus-menerus (440/401), coba
#   perbarui ke versi terbaru dari https://web.whatsapp.com/ atau npm baileys.
#   Kosongkan salah satu angkanya (mis. "2,3000") agar memakai versi otomatis.
WA_VERSION=2,3000,1045101284

# Identitas browser, format: OS,Browser,Versi. Default macOS + Chrome
#   (kombinasi yang dipakai neoxr-bot dan tahan lama).
WA_BROWSER=Mac OS,Chrome,139.0.7258.164

# ---------------- Web Dashboard Admin ----------------
# NODE_ENV=production WAJIB diisi saat dashboard online (HTTPS).
#   production -> cookie sesi otomatis diberi flag Secure
#   development -> cookie tanpa Secure (hanya untuk localhost)
NODE_ENV=development
WEB_PORT=3000
WEB_ENABLED=true
# Domain dashboard Anda (CORS). Kosong = menerima semua origin (TIDAK disarankan).
#   Contoh: https://catataja.id
WEB_ORIGIN=

# JWT_SECRET: WAJIB diganti. Minimal 32 karakter, TIDAK boleh nilai contoh di
# bawah. Aplikasi MENOLAK START bila masih placeholder / kurang dari 32 char.
#   Buat secret acak:
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti_dengan_secret_panjang
JWT_EXPIRES=30m
REFRESH_EXPIRES=7d

# Password admin pertama (dipakai HANYA saat data/admin_users.json masih kosong).
# Minimal 8 karakter dan TIDAK boleh owner123/admin123 — aplikasi menolak start
# bila password default masih dipakai.
# GANTI setelah login pertama lewat menu Admin Users di dashboard.
WEB_OWNER_USERNAME=owner
WEB_OWNER_PASSWORD=owner123
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=admin123

# Paksa cookie sesi memakai flag Secure (butuh HTTPS). Default: aktif otomatis
# bila NODE_ENV=production.
COOKIE_SECURE=false

# ---------------- 9router (Fallback Provider) ----------------
# Provider OpenAI-compatible dari 9router (https://9router.com).
# Digunakan sebagai pilihan KEDUA ketika semua model/API key Gemini
# habis limit (429) atau gagal. Mendukung teks, gambar (vision), dan
# voice note (audio input) tergantung model yang dipilih.
#   Base URL : http://103.52.212.115:20129/v1
#   API Key  : sk-... (dari 9router)
#   Model    : bisa daftar beberapa, pisah koma (urutan = prioritas)
NINE_ROUTER_BASE_URL=http://103.52.212.115:20129/v1
NINE_ROUTER_API_KEY=isi_api_key_9router
NINE_ROUTER_MODEL=ag/gemini-3.8-flash,ag/gemini-3.1-pro-high
