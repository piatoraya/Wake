<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('partials/head') %>
</head>
<body>
<script src="/assets/static/js/initTheme.js"></script>
<div id="app">
  <div id="sidebar" class="active"><%- include('partials/sidebar') %></div>
  <div id="main">
    <%- include('partials/navbar') %>
    <div class="page-heading"><h3>Kontak & Support Settings</h3></div>
    <div class="page-content">
      <div class="card">
        <div class="card-header"><h4>Pengaturan Kontak</h4></div>
        <div class="card-body">
          <p class="text-muted">Informasi ini akan tampil dinamis di Landing Page melalui endpoint publik.</p>
          <div id="contactsForm"></div>
        </div>
      </div>
    </div>
    <%- include('partials/footer') %>
  </div>
</div>
<script src="/assets/static/js/components/dark.js"></script>
<script src="/assets/extensions/perfect-scrollbar/perfect-scrollbar.min.js"></script>
<script src="/assets/compiled/js/app.js"></script>
<script>
  async function loadContacts() {
    const res = await fetch('/api/contacts', {credentials:'same-origin'});
    const data = await res.json();
    if (!data.success) { document.getElementById('contactsForm').textContent = 'Gagal memuat'; return; }
    const container = document.getElementById('contactsForm');
    container.innerHTML = data.data.map(c => `
      <div class="mb-4 p-3 border rounded">
        <div class="mb-2"><strong>${c.label}</strong> <small class="text-muted">(${c.key})</small></div>
        <div class="mb-2">
          <label class="form-label">Label</label>
          <input type="text" class="form-control" id="label_${c.key}" value="${c.label}">
        </div>
        <div class="mb-2">
          <label class="form-label">Value</label>
          <input type="text" class="form-control" id="value_${c.key}" value="${c.value || ''}" placeholder="Isi nilai kontak">
        </div>
        <div class="form-check mb-2">
          <input type="checkbox" class="form-check-input" id="active_${c.key}" ${c.is_active ? 'checked' : ''}>
          <label class="form-check-label" for="active_${c.key}">Aktif (tampil di landing page)</label>
        </div>
        <button class="btn btn-primary btn-sm" onclick="saveContact('${c.key}')">Simpan</button>
        <span id="status_${c.key}" class="ms-2 text-success"></span>
      </div>
    `).join('');
  }
  async function saveContact(key) {
    const body = {
      label: document.getElementById('label_' + key).value,
      value: document.getElementById('value_' + key).value,
      is_active: document.getElementById('active_' + key).checked,
    };
    const res = await fetch('/api/contacts/' + key, {method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body), credentials:'same-origin'});
    const data = await res.json();
    const st = document.getElementById('status_' + key);
    if (data.success) { st.textContent = 'Tersimpan'; setTimeout(()=>st.textContent='',2000); }
    else { st.textContent = data.error?.message || 'Gagal'; st.classList.remove('text-success'); st.classList.add('text-danger'); }
  }
  loadContacts();
</script>
</body>
</html>
