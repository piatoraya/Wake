<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('partials/head') %>
</head>
<body>
<script src="/assets/static/js/initTheme.js"></script>
<div id="app">
  <div id="sidebar" class="active"><%- include('partials/sidebar') %></div>
  <div id="main">
    <%- include('partials/navbar') %>
    <div class="page-heading"><h3>Bot Instances (Sultan)</h3></div>
    <div class="page-content">
      <div class="card mb-3">
        <div class="card-body">
          <form id="createForm" class="row g-2 align-items-end">
            <div class="col-md-3">
              <label class="form-label">Owner Phone</label>
              <input type="text" id="ownerPhone" class="form-control" placeholder="628...">
            </div>
            <div class="col-md-3">
              <label class="form-label">Nama Bot</label>
              <input type="text" id="botName" class="form-control" placeholder="bot_toko_budi">
            </div>
            <div class="col-md-2">
              <label class="form-label">Nomor Bot (pairing)</label>
              <input type="text" id="botPhone" class="form-control" placeholder="628...">
            </div>
            <div class="col-md-2">
              <label class="form-label">Metode</label>
              <select id="botMethod" class="form-select"><option value="pairing">Pairing Code</option><option value="qr">QR Code</option></select>
            </div>
            <div class="col-md-2">
              <button type="submit" class="btn btn-primary">Buat Instance</button>
            </div>
          </form>
          <div id="createStatus" class="mt-2 small text-muted"></div>
        </div>
      </div>
      <div class="card">
        <div class="card-body">
          <table class="table table-striped">
            <thead><tr><th>Nama</th><th>Owner</th><th>Slug</th><th>Session Dir</th><th>Status</th><th>Aksi</th></tr></thead>
            <tbody id="instanceBody"></tbody>
          </table>
        </div>
      </div>
      <div class="card mt-3">
        <div class="card-header"><h4>QR Code</h4></div>
        <div class="card-body text-center">
          <div id="qrBox" style="display:inline-block;"></div>
          <div id="qrStatus" class="mt-2 small text-muted"></div>
        </div>
      </div>
    </div>
    <%- include('partials/footer') %>
  </div>
</div>
<script src="/assets/static/js/components/dark.js"></script>
<script src="/assets/extensions/perfect-scrollbar/perfect-scrollbar.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script src="/assets/compiled/js/app.js"></script>
<script>
  async function loadInstances() {
    const res = await fetch('/api/bot-instances', {credentials:'same-origin'});
    const data = await res.json();
    if (!data.success) return;
    document.getElementById('instanceBody').innerHTML = data.data.map(i => `
      <tr>
        <td>${i.name}</td>
        <td>${i.owner_phone}</td>
        <td>${i.slug}</td>
        <td>${i.phone||'-'}</td>
        <td><code>${i.session_dir}</code></td>
        <td>${i.status}${i.pairing_code ? ' (kode: '+i.pairing_code+')' : ''}</td>
        <td>
          <button class="btn btn-sm btn-outline-success" onclick="startInst('${i.bot_id}','${i.connection_method||'pairing'}')">Start</button>
          <button class="btn btn-sm btn-outline-primary" onclick="pairInst('${i.bot_id}')">Pairing Code</button>
          <button class="btn btn-sm btn-outline-info" onclick="showQr('${i.bot_id}')">QR</button>
          <button class="btn btn-sm btn-outline-secondary" onclick="stopInst('${i.bot_id}')">Stop</button>
          <button class="btn btn-sm btn-outline-warning" onclick="resetAuth('${i.bot_id}')">Reset Auth</button>
          <button class="btn btn-sm btn-outline-danger" onclick="delInstance('${i.bot_id}')">Hapus</button>
        </td>
      </tr>
    `).join('');
  }
  document.getElementById('createForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const status = document.getElementById('createStatus');
    status.textContent = 'Membuat...';
    const res = await fetch('/api/bot-instances', {
      method: 'POST', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ owner_phone: document.getElementById('ownerPhone').value.trim(), name: document.getElementById('botName').value.trim(), phone: document.getElementById('botPhone').value.trim(), method: document.getElementById('botMethod').value }),
    });
    const data = await res.json();
    if (data.success) { status.textContent = 'Instance dibuat.'; status.className='mt-2 small text-success'; loadInstances(); }
    else { status.textContent = data.error?.message || 'Gagal'; status.className='mt-2 small text-danger'; }
  });
  async function startInst(id, method) {
    const res = await fetch('/api/bot-instances/'+id+'/start', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ method }) });
    const data = await res.json();
    if (!data.success) alert(data.error?.message || 'Gagal start');
    loadInstances();
  }
  async function showQr(id) {
    const status = document.getElementById('qrStatus');
    const box = document.getElementById('qrBox');
    box.innerHTML = '';
    status.textContent = 'Mengambil QR...';
    // ensure started in qr mode
    await fetch('/api/bot-instances/'+id+'/start', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ method: 'qr', force: true }) });
    const instRes = await fetch('/api/bot-instances/'+id, { credentials: 'same-origin' });
    const instData = await instRes.json();
    if (instData.success && instData.data.status === 'connected') {
      status.textContent = 'Instance sudah terhubung.';
      return;
    }
    // poll for qr
    let attempts = 0;
    const timer = setInterval(async () => {
      attempts++;
      let res, data;
      try {
        res = await fetch('/api/bot-instances/'+id+'/qr', { credentials: 'same-origin' });
        data = await res.json();
      } catch (e) {
        status.textContent = 'Gagal mengambil QR: ' + e.message;
        return;
      }
      if (data.success && data.data.qr) {
        clearInterval(timer);
        box.innerHTML = '';
        try {
          new QRCode(box, { text: data.data.qr, width: 220, height: 220 });
          status.textContent = 'Pindai QR ini dengan WhatsApp.';
        } catch (e) {
          status.textContent = 'Gagal render QR (library). Menampilkan ASCII.';
        }
        if (data.data.ascii) {
          const pre = document.createElement('pre');
          pre.style.fontSize = '8px';
          pre.style.lineHeight = '8px';
          pre.textContent = data.data.ascii;
          box.appendChild(pre);
        }
        loadInstances();
      } else if (attempts > 20) {
        clearInterval(timer);
        status.textContent = 'QR belum tersedia. Coba lagi.';
      }
    }, 1500);
  }
  async function pairInst(id) {
    try {
      const res = await fetch('/api/bot-instances/'+id+'/pairing-code', { method: 'POST', credentials: 'same-origin' });
      const data = await res.json();
      if (!data.success && /Nomor bot belum diisi/i.test(data.error?.message || '')) {
        const phone = prompt('Masukkan nomor bot (628...):');
        if (phone) {
          await fetch('/api/bot-instances/'+id, { method: 'PUT', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ phone: phone.trim() }) });
          return pairInst(id);
        }
      }
      if (data.success) { alert('Kode pairing: ' + (data.data.code || 'sudah terhubung')); loadInstances(); }
      else alert(data.error?.message || 'Gagal pairing');
    } catch (e) {
      console.error(e);
      alert('Error: ' + (e && e.message ? e.message : e));
    }
  }
  async function resetAuth(id) {
    if (!confirm('Hapus auth lama dan reset instance?')) return;
    const res = await fetch('/api/bot-instances/'+id+'/reset-auth', { method: 'POST', credentials: 'same-origin' });
    const data = await res.json();
    if (!data.success) alert(data.error?.message || 'Gagal reset auth');
    loadInstances();
  }
  async function stopInst(id) {
    const res = await fetch('/api/bot-instances/'+id+'/stop', { method: 'POST', credentials: 'same-origin' });
    const data = await res.json();
    if (!data.success) alert(data.error?.message || 'Gagal stop');
    loadInstances();
  }
  async function delInstance(id) {
    if (!confirm('Hapus instance ini?')) return;
    const res = await fetch('/api/bot-instances/'+id, { method: 'DELETE', credentials: 'same-origin' });
    const data = await res.json();
    if (data.success) loadInstances();
    else alert(data.error?.message || 'Gagal');
  }
  loadInstances();
</script>
</body>
</html>