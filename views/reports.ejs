<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('partials/head') %>
</head>
<body>
<script src="/assets/static/js/initTheme.js"></script>
<div id="app">
  <div id="sidebar" class="active"><%- include('partials/sidebar') %></div>
  <div id="main">
    <%- include('partials/navbar') %>
    <div class="page-heading"><h3>Laporan</h3></div>
    <div class="page-content">
      <div class="card mb-3">
        <div class="card-body">
          <div class="row g-2 align-items-end">
            <div class="col-md-3">
              <label class="form-label">Bulan</label>
              <input type="month" id="repMonth" class="form-control">
            </div>
            <div class="col-md-3">
              <button class="btn btn-primary" id="loadSummary">Tampilkan Ringkasan</button>
            </div>
            <div class="col-md-6 text-end">
              <a id="expCsv" class="btn btn-outline-secondary" target="_blank">Export CSV</a>
              <a id="expXlsx" class="btn btn-outline-success" target="_blank">Export Excel</a>
              <a id="expPdf" class="btn btn-outline-danger" target="_blank">Export PDF</a>
            </div>
          </div>
        </div>
      </div>
      <div class="card">
        <div class="card-header"><h4>Ringkasan Bulanan</h4></div>
        <div class="card-body" id="summaryBody">Pilih bulan lalu klik Tampilkan.</div>
      </div>

      <div class="card mt-3">
        <div class="card-header"><h4>Restore Backup (Owner only)</h4></div>
        <div class="card-body">
          <div class="row g-2 align-items-end">
            <div class="col-md-4">
              <label class="form-label">Nomor User</label>
              <input type="text" id="restorePhone" class="form-control" placeholder="628...">
            </div>
            <div class="col-md-4">
              <label class="form-label">File Backup JSON</label>
              <input type="file" id="restoreFile" class="form-control" accept="application/json">
            </div>
            <div class="col-md-2">
              <label class="form-label">Mode</label>
              <select id="restoreMode" class="form-select"><option value="replace">Replace</option><option value="merge">Merge</option></select>
            </div>
            <div class="col-md-2">
              <button class="btn btn-warning" id="restoreBtn">Restore</button>
            </div>
          </div>
          <div id="restoreStatus" class="mt-2 small text-muted"></div>
        </div>
      </div>
    </div>
    <%- include('partials/footer') %>
  </div>
</div>
<script src="/assets/static/js/components/dark.js"></script>
<script src="/assets/extensions/perfect-scrollbar/perfect-scrollbar.min.js"></script>
<script src="/assets/compiled/js/app.js"></script>
<script>
  const fmt = (n) => 'Rp ' + Math.round(n||0).toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');
  const monthInput = document.getElementById('repMonth');
  const now = new Date();
  monthInput.value = now.toISOString().slice(0,7);

  function updateLinks() {
    const m = monthInput.value;
    document.getElementById('expCsv').href = '/api/reports/export?format=csv&month=' + m;
    document.getElementById('expXlsx').href = '/api/reports/export?format=xlsx&month=' + m;
    document.getElementById('expPdf').href = '/api/reports/export?format=pdf&month=' + m;
  }
  updateLinks();
  monthInput.addEventListener('change', updateLinks);

  document.getElementById('loadSummary').addEventListener('click', async () => {
    const m = monthInput.value;
    const res = await fetch('/api/reports/summary?month=' + m, {credentials:'same-origin'});
    const data = await res.json();
    if (!data.success) { document.getElementById('summaryBody').textContent = data.error?.message || 'Gagal'; return; }
    const d = data.data;
    document.getElementById('summaryBody').innerHTML = `
      <p><strong>${esc(d.monthLabel)}</strong></p>
      <p>Pemasukan: ${fmt(d.totalIncome)} | Pengeluaran: ${fmt(d.totalExpense)} | Net: ${fmt(d.net)}</p>
      <h5>Per Kategori</h5>
      <ul>${d.categories.map(c=>`<li>${esc(c.category)}: ${fmt(c.amount)}</li>`).join('')}</ul>
      <h5>Per Pengguna</h5>
      <table class="table table-sm"><thead><tr><th>Nama</th><th>Tx</th><th>Pemasukan</th><th>Pengeluaran</th><th>Net</th></tr></thead><tbody>
      ${d.perUser.map(u=>`<tr><td>${esc(u.name||u.phone)}</td><td>${Number(u.count)}</td><td>${fmt(u.income)}</td><td>${fmt(u.expense)}</td><td>${fmt(u.net)}</td></tr>`).join('')}
      </tbody></table>
    `;
  });

  document.getElementById('restoreBtn').addEventListener('click', async () => {
    const phone = document.getElementById('restorePhone').value.trim();
    const file = document.getElementById('restoreFile').files[0];
    const mode = document.getElementById('restoreMode').value;
    const status = document.getElementById('restoreStatus');
    if (!phone || !file) { status.textContent = 'Nomor dan file wajib diisi.'; status.className='mt-2 small text-danger'; return; }
    status.textContent = 'Membaca file...';
    const reader = new FileReader();
    reader.onload = async () => {
      let parsed;
      try { parsed = JSON.parse(reader.result); } catch (e) { status.textContent = 'File bukan JSON valid.'; status.className='mt-2 small text-danger'; return; }
      status.textContent = 'Mengirim restore...';
      const res = await fetch('/api/restore', {
        method: 'POST', credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ phone, backup: parsed, mode }),
      });
      const data = await res.json();
      if (data.success) {
        status.textContent = `Restore selesai. ${data.data.restored} transaksi dipulihkan.`;
        status.className = 'mt-2 small text-success';
      } else {
        status.textContent = data.error?.message || 'Gagal restore';
        status.className = 'mt-2 small text-danger';
      }
    };
    reader.readAsText(file);
  });
</script>
</body>
</html>
