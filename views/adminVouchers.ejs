<!DOCTYPE html>
<html lang="id" data-bs-theme="light">
<head>
  <%- include('partials/head') %>
</head>
<body>
<div id="app">
  <div id="main">
    <%- include('partials/sidebar') %>
    <div id="main-content">
      <div class="page-heading">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
          <div>
            <h3>Voucher</h3>
            <p class="text-muted mb-0">Kode diskon untuk pembelian paket.</p>
          </div>
          <button class="btn btn-success" id="new-btn">Voucher Baru</button>
        </div>
      </div>

      <section class="section">
        <div id="error-box" class="alert alert-danger d-none" role="alert"></div>
        <div id="ok-box" class="alert alert-success d-none" role="alert"></div>

        <div class="card d-none" id="form-card">
          <div class="card-body">
            <h6 class="fw-bold mb-3" id="form-title">Voucher Baru</h6>
            <div class="row g-3">
              <div class="col-md-3">
                <label class="form-label">Kode</label>
                <input class="form-control" id="f-code" maxlength="40" placeholder="HEMAT10">
              </div>
              <div class="col-md-3">
                <label class="form-label">Tipe Diskon</label>
                <select class="form-select" id="f-type">
                  <option value="percent">Persen (%)</option>
                  <option value="fixed">Nominal (Rp)</option>
                </select>
              </div>
              <div class="col-md-3">
                <label class="form-label">Nilai Diskon</label>
                <input type="number" class="form-control" id="f-value" min="0" value="10">
              </div>
              <div class="col-md-3">
                <label class="form-label">Kuota <span class="text-muted">(kosong = tanpa batas)</span></label>
                <input type="number" class="form-control" id="f-quota" min="0">
              </div>
              <div class="col-md-3">
                <label class="form-label">Min. Belanja (Rp)</label>
                <input type="number" class="form-control" id="f-min" min="0" value="0">
              </div>
              <div class="col-md-3">
                <label class="form-label">Maks. per User</label>
                <input type="number" class="form-control" id="f-maxuser" min="1" value="1">
              </div>
              <div class="col-md-3">
                <label class="form-label">Paket Berlaku</label>
                <select class="form-select" id="f-plan">
                  <option value="">Semua paket</option>
                </select>
              </div>
              <div class="col-md-3">
                <label class="form-label">Status</label>
                <select class="form-select" id="f-active">
                  <option value="true">Aktif</option>
                  <option value="false">Nonaktif</option>
                </select>
              </div>
              <div class="col-md-3">
                <label class="form-label">Mulai <span class="text-muted">(opsional)</span></label>
                <input type="date" class="form-control" id="f-start">
              </div>
              <div class="col-md-3">
                <label class="form-label">Berakhir <span class="text-muted">(opsional)</span></label>
                <input type="date" class="form-control" id="f-expire">
              </div>
              <div class="col-12 d-flex gap-2">
                <button class="btn btn-success" id="save-btn">Simpan</button>
                <button class="btn btn-outline-secondary" id="cancel-btn">Batal</button>
              </div>
            </div>
          </div>
        </div>

        <div class="card mt-3">
          <div class="card-body">
            <div class="table-responsive" id="table-wrap">
              <p class="text-muted">Memuat voucher…</p>
            </div>
          </div>
        </div>
      </section>
    </div>
    <%- include('partials/footer') %>
  </div>
</div>

<script src="/assets/compiled/js/app.js"></script>
<script>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var editing = null; // kode yang sedang diedit, null = baru

  function fmt(n) { return 'Rp ' + Number(n || 0).toLocaleString('id-ID'); }
  function showErr(m) { var b = $('error-box'); if (!m) { b.classList.add('d-none'); return; } b.textContent = m; b.classList.remove('d-none'); }
  function showOk(m) { var b = $('ok-box'); if (!m) { b.classList.add('d-none'); return; } b.textContent = m; b.classList.remove('d-none'); }

  var STATUS_CLS = {
    'aktif': 'bg-success', 'nonaktif': 'bg-secondary',
    'kedaluwarsa': 'bg-danger', 'terjadwal': 'bg-info text-dark', 'kuota habis': 'bg-warning text-dark',
  };

  function load() {
    return apiGet('/api/vouchers').then(function (res) {
      var d = res.data || {};
      var opts = d.options || {};
      $('f-plan').innerHTML = '<option value="">Semua paket</option>' +
        (opts.plans || []).map(function (s) { return '<option value="' + esc(s) + '">' + esc(s) + '</option>'; }).join('');
      render(d.vouchers || []);
    }).catch(function (e) { showErr(e.message); });
  }

  function render(list) {
    var wrap = $('table-wrap');
    if (!list.length) { wrap.innerHTML = '<p class="text-muted">Belum ada voucher.</p>'; return; }

    wrap.innerHTML = '<table class="table table-sm align-middle"><thead><tr>' +
      '<th>Kode</th><th>Diskon</th><th>Kuota</th><th>Berlaku</th><th>Status</th><th></th>' +
      '</tr></thead><tbody>' + list.map(function (v) {
        var disc = v.discount_type === 'fixed' ? fmt(v.discount_value) : (Number(v.discount_value) || 0) + '%';
        var quota = v.quota === null ? '∞' : (v.used_count || 0) + ' / ' + v.quota + ' (sisa ' + v.remaining_quota + ')';
        var berlaku = (v.plan_slug || 'semua') + ' · min ' + fmt(v.min_amount);
        return '<tr>' +
          '<td><code>' + esc(v.code) + '</code></td>' +
          '<td>' + esc(disc) + '</td>' +
          '<td>' + esc(quota) + '</td>' +
          '<td><small>' + esc(berlaku) + '</small></td>' +
          '<td><span class="badge ' + (STATUS_CLS[v.status] || 'bg-secondary') + '">' + esc(v.status) + '</span></td>' +
          '<td class="text-nowrap">' +
            '<button class="btn btn-sm btn-outline-success" data-edit="' + esc(v.code) + '">Edit</button> ' +
            '<button class="btn btn-sm btn-outline-danger" data-del="' + esc(v.code) + '">Hapus</button>' +
          '</td>' +
        '</tr>';
      }).join('') + '</tbody></table>';

    wrap.querySelectorAll('[data-edit]').forEach(function (b) {
      b.addEventListener('click', function () { startEdit(b.dataset.edit); });
    });
    wrap.querySelectorAll('[data-del]').forEach(function (b) {
      b.addEventListener('click', function () {
        if (!confirm('Hapus voucher ' + b.dataset.del + '?')) return;
        apiDelete('/api/vouchers/' + encodeURIComponent(b.dataset.del))
          .then(function () { showOk('Voucher dihapus.'); load(); })
          .catch(function (e) { showErr(e.message); });
      });
    });
  }

  function resetForm() {
    editing = null;
    $('form-title').textContent = 'Voucher Baru';
    $('f-code').value = ''; $('f-code').disabled = false;
    $('f-type').value = 'percent'; $('f-value').value = 10;
    $('f-quota').value = ''; $('f-min').value = 0; $('f-maxuser').value = 1;
    $('f-plan').value = ''; $('f-active').value = 'true';
    $('f-start').value = ''; $('f-expire').value = '';
  }

  function startEdit(code) {
    apiGet('/api/vouchers/' + encodeURIComponent(code)).then(function (res) {
      var v = res.data || {};
      editing = v.code;
      $('form-title').textContent = 'Edit ' + v.code;
      $('f-code').value = v.code || '';
      $('f-code').disabled = true; // kode tidak diubah saat edit
      $('f-type').value = v.discount_type || 'percent';
      $('f-value').value = v.discount_value || 0;
      $('f-quota').value = v.quota === null || v.quota === undefined ? '' : v.quota;
      $('f-min').value = v.min_amount || 0;
      $('f-maxuser').value = v.max_per_user || 1;
      $('f-plan').value = v.plan_slug || '';
      $('f-active').value = v.is_active === false ? 'false' : 'true';
      $('f-start').value = v.starts_at ? String(v.starts_at).slice(0, 10) : '';
      $('f-expire').value = v.expires_at ? String(v.expires_at).slice(0, 10) : '';
      $('form-card').classList.remove('d-none');
      $('form-card').scrollIntoView({ behavior: 'smooth' });
    }).catch(function (e) { showErr(e.message); });
  }

  $('new-btn').addEventListener('click', function () {
    resetForm();
    $('form-card').classList.remove('d-none');
  });
  $('cancel-btn').addEventListener('click', function () {
    $('form-card').classList.add('d-none');
    showErr('');
  });

  $('save-btn').addEventListener('click', function () {
    var body = {
      discount_type: $('f-type').value,
      discount_value: Number($('f-value').value) || 0,
      quota: $('f-quota').value === '' ? null : Number($('f-quota').value),
      min_amount: Number($('f-min').value) || 0,
      max_per_user: Number($('f-maxuser').value) || 1,
      plan_slug: $('f-plan').value || null,
      is_active: $('f-active').value === 'true',
      starts_at: $('f-start').value || null,
      expires_at: $('f-expire').value || null,
    };

    var req;
    if (editing) {
      req = apiPut('/api/vouchers/' + encodeURIComponent(editing), body);
    } else {
      body.code = $('f-code').value.trim().toUpperCase();
      req = apiPost('/api/vouchers', body);
    }

    req.then(function () {
      showOk(editing ? 'Voucher diperbarui.' : 'Voucher dibuat.');
      $('form-card').classList.add('d-none');
      resetForm();
      load();
    }).catch(function (e) { showErr(e.message); });
  });

  resetForm();
  load();
})();
</script>
</body>
</html>
